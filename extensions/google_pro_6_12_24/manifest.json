{
  "manifest_version": 3,
  "name": "Google AI Pro 24M Offer Injector",
  "version": "1.0.0",
  "description": "Bộ kích hoạt và tiêm mã ưu đãi Google One / AI Pro 24 tháng (Bản Tiếng Việt)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://one.google.com/*",
    "https://tokenized.play.google.com/*",
    "https://play.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google AI Pro 24M Injector"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://one.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://one.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://tokenized.play.google.com/*"],
      "js": ["play_guard.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
